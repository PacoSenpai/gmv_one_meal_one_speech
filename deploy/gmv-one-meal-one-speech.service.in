[Unit]
Description=GMV One Meal, One Speech web application
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/default/gmv-one-meal-one-speech
ExecStart=@APP_DIR@/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=4
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@APP_DIR@/instance

[Install]
WantedBy=multi-user.target
