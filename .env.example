# Placeholders locales: reemplázalos con claves aleatorias distintas. No usar en producción.
APP_ENV=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_HEX_CHARACTERS_
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_64_HEX_CHARACTERS

DATABASE_URL=sqlite:///portal.sqlite3
UPLOAD_FOLDER=instance/uploads
COOKIE_SECURE=0
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_COUNT=0
# Duración de la sesión cuando se marca "Mantener sesión iniciada".
SESSION_REMEMBER_DAYS=30
